NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# The API uses the restricted role; migration credentials are for maintenance only.
DATABASE_URL=postgresql://ritmo_app:YOUR_RUNTIME_PASSWORD@localhost:5432/gamification?schema=public
MIGRATION_DATABASE_URL=postgresql://gamification:YOUR_LOCAL_PASSWORD@localhost:5432/gamification?schema=public
CORS_ORIGINS=http://localhost:5173
# Required. Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ISSUER=gamification-api
JWT_AUDIENCE=gamification-app
JWT_TTL_SECONDS=3600
DEFAULT_TIME_ZONE=America/La_Paz
XP_PER_COMPLETION=20
